{
  "version": "phonetic-relation-direction-contract-v1",
  "schema": "user-feature-schema-v1",
  "index": "PHONETIC_FEATURE_INDEX_V1",
  "semantics": {
    "user_feature_X_Y": "User tends to produce Y when canonical is X (canonical→observed confusion).",
    "candidate_relation_match": "Observed source has Y and candidate has X → matches user feature X_Y.",
    "example": {
      "user_feature": "n_l",
      "canonical": "nai3",
      "observed": "lai3",
      "candidate": "nai3",
      "boosts_feature": "n_l",
      "not_feature": "l_n"
    }
  },
  "component_type": {
    "n_l": "initial",
    "l_n": "initial",
    "zh_z": "initial",
    "z_zh": "initial",
    "ch_c": "initial",
    "c_ch": "initial",
    "sh_s": "initial",
    "s_sh": "initial",
    "f_h": "initial",
    "h_f": "initial",
    "an_ang": "final",
    "ang_an": "final",
    "en_eng": "final",
    "eng_en": "final",
    "in_ing": "final",
    "ing_in": "final"
  },
  "features": [
    {
      "user_feature": "n_l",
      "index": 0,
      "canonical_component": "n",
      "observed_component": "l",
      "match_rule": "source.initial==l AND candidate.initial==n",
      "opposite_feature": "l_n"
    },
    {
      "user_feature": "l_n",
      "index": 1,
      "canonical_component": "l",
      "observed_component": "n",
