      "bounded": true,
      "note": "apply reverse A then B on syllables; order matters; capped pairs"
    },
    {
      "id": "identity_skip",
      "params": [],
      "deterministic": true,
      "note": "no profile expansion"
    }
  ],
  "deferred_primitives": [
    "apply_tone_variant",
    "domain_filtered_query",
    "personal_term_query",
    "phonetic_distance_query_extra"
  ],
  "max_single_actions": 7,
  "max_pair_actions": 21,
  "max_actions_evaluated_offline": 32,
  "model_emits": ["action_scores", "query_budget", "candidate_budget_hint"],
