{
  "schema": "MODEL3_ACCEPTANCE_UPSTREAM_SNAPSHOT_V1",
  "scope": "test_audit_only",
  "notJobResult": true,
  "notProductionApi": true,
  "immutability": "structuredClone per branch + upstreamHash equality after each branch",
  "hashAlgorithm": "sha256_canonical_json_v1",
  "hashedFields": [
    "rawAsrText",
    "pathId",
    "pathFineSpans.spanId",
    "pathFineSpans.rawStart",
    "pathFineSpans.rawEnd",
    "pathFineSpans.surface",
    "pathFineSpans.syllableStart",
    "pathFineSpans.syllableEnd",
    "pathFineSpans.candidateIds",
    "pathFineSpans.candidateCount",
    "candidateState.candidateId",
    "candidateState.replacement",
    "candidateState.originSpanId",
    "candidateState.source",
    "candidateState.domains",
    "candidateState.isCovered",
    "retainedDomains",
    "anchors.spanId",
    "anchors.surface",
    "anchors.rawStart",
    "anchors.rawEnd",
    "anchors.source",
    "packedSpans.spanId",
    "packedSpans.tokenIds",
    "packedSpans.featVector",
    "packedSpans.availMask",
    "packedSpans.features",
    "packedSpans.isAnchor"
  ],
  "excludedFromHash": [
    "timestamps",
    "objectAddresses",
    "logTimestamps",
    "postModel3Decisions",
    "postRetryCandidates",
    "finalOutput"
  ],
  "metricUnitsSsot": {
    "RAW_PATH_RETRY_SPAN": "path-level Model3 RETRY decision count",
    "LOGICAL_UNIQUE_RETRY_SPAN": "dedup (caseId,start,end,surface)",
    "RETRY_REGION": "merged retry region from routeModel3Retry",
    "RETRY_ROUTING_ATTEMPT": "per-span retry routing call",
    "CANDIDATE_RETURN_EVENT": "recall return with count>0",
    "CASE_WITH_ANY_RETRY": "case with >=1 actionable RETRY"
  }
}
